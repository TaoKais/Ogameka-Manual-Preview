{
  "manifest_version": 3,
  "name": "Ogameka",
  "version": "0.3.0",
  "description": "User-triggered visible capture.",
  "action": {
    "default_title": "Capture and sync visible OGame data",
    "default_popup": "extension/popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1:3176/*"
  ]
}
